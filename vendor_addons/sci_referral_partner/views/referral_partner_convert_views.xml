<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_referral_partner_convert_form" model="ir.ui.view">
        <field name="name">sci.referral.partner.convert.form</field>
        <field name="model">sci.referral.partner.convert</field>
        <field name="arch" type="xml">
            <form string="Convertir en Partner">
                <field name="partner_id" invisible="1"/>
                <div class="mb-3">
                    Este contacto se marcara como <b>Partner referido</b> y se generara
                    un codigo unico, personal e intransferible.
                </div>
                <group>
                    <field name="referral_agreement_date"/>
                    <field name="referral_contract_end_date"/>
                    <field name="referral_partner_contract_file_name" invisible="1"/>
                    <field name="referral_partner_contract" widget="binary"
                           filename="referral_partner_contract_file_name"/>
                </group>
                <footer>
                    <button name="action_convert" type="object" string="Convertir"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_referral_partner_convert" model="ir.actions.act_window">
        <field name="name">Convertir en Partner</field>
        <field name="res_model">sci.referral.partner.convert</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_partner_id': active_id}</field>
    </record>
</odoo>
