<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_referral" model="ir.ui.view">
        <field name="name">account.move.form.referral</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="referral_referrer_id"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="referral_commission_generated" invisible="1"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_referral_generate_commission" type="object"
                        string="Generar comision de referido"
                        invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted' or referral_commission_generated"/>
            </xpath>
        </field>
    </record>
</odoo>
