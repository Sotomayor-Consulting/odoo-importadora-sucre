<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_payslip_ec" model="ir.actions.report">
        <field name="name">Ecuador: Rol de pagos</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ec_hr_payroll.report_payslip_ec_lang</field>
        <field name="report_file">l10n_ec_hr_payroll.report_payslip_ec_lang</field>
        <field name="print_report_name">'Rol de pagos - %s' % (object.employee_id.name)</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
        <!-- Vacios para evitar publicar el PDF dos veces (igual que el reporte estandar) -->
        <field name="attachment"></field>
        <field name="attachment_use" eval="False"/>
    </record>
</odoo>
