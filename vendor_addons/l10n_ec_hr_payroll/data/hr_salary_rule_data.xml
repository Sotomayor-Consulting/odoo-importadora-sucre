<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reglas salariales de Ecuador. Convencion de Odoo: deducciones en negativo y
         NET = BASIC + ALW + DED. Las reglas COMP (provisiones y aportes patronales) no afectan al neto.
         Costo del empleador = neto + reglas COMP (provisiones y aportes patronales).
         Codigos iguales a los tipos de entrada que vienen de ajustes salariales (EC_PREST_*, EC_DESCUENTO, EC_BONO). -->

    <!-- ===================== Estructura: Empleado ===================== -->
    <record id="l10n_ec_rule_employee_basic" model="hr.salary.rule">
        <field name="name">Sueldo</field>
        <field name="code">BASIC</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="struct_id" ref="l10n_ec_structure_employee"/>
        <field name="condition_select">none</field>
        <field name="appears_on_employee_cost_dashboard" eval="False"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._l10n_ec_get_daily_wage()
result_qty = payslip._l10n_ec_get_paid_days()</field>
        <field name="bold" eval="True"/>
        <field name="note">Días pagados x valor diario (sueldo / 30). Mes comercial de 30 días desde las fechas del contrato, menos los días no laborados.</field>
    </record>

    <record id="l10n_ec_rule_employee_ec_horas_supl" model="hr.salary.rule">
        <field name="name">Horas suplementarias (50 %)</field>
        <field name="code">EC_HORAS_SUPL</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="l10n_ec_category_alw_gravable"/>
        <field name="struct_id" ref="l10n_ec_structure_employee"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = 'EC_HORAS_SUPL' in inputs</field>
        <field name="appears_on_employee_cost_dashboard" eval="False"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._l10n_ec_get_hourly_wage() * 1.5
result_qty = inputs['EC_HORAS_SUPL'].amount</field>
        <field name="note">Valor hora (sueldo / 240) x 1.5 x horas. Art. 55 Código del Trabajo.</field>
    </record>

