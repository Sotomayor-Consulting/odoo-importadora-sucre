    <record id="l10n_ec_rule_employee_ec_d13_mes" model="hr.salary.rule">
        <field name="name">Décimo tercero mensualizado</field>
        <field name="code">EC_D13_MES</field>
        <field name="sequence">200</field>
        <field name="category_id" ref="l10n_ec_category_alw_no_gravable"/>
        <field name="struct_id" ref="l10n_ec_structure_employee"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = not version.l10n_ec_13th_salary_accumulate</field>
        <field name="appears_on_employee_cost_dashboard" eval="False"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = categories['GROSS'] / 12</field>
        <field name="note">1/12 del sueldo imponible, pagado en el rol.</field>
    </record>

