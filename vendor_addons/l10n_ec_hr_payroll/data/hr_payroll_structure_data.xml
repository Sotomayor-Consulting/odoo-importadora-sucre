<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- rule_ids vacio: evita que Odoo copie sus reglas por defecto; las reglas estan en hr_salary_rule_data.xml.
         use_worked_day_lines False: la nomina no depende de las entradas de trabajo; el sueldo se prorratea
         con mes comercial de 30 dias desde las fechas del contrato y las ausencias sin sueldo se ingresan
         con la entrada EC_DIAS_NO_PAGADOS. Si se activan las entradas de trabajo, LEAVE90 tambien descuenta. -->
    <record id="l10n_ec_structure_employee" model="hr.payroll.structure">
        <field name="name">Ecuador: Nómina mensual empleado</field>
        <field name="code">EC_EMPLEADO</field>
        <field name="report_id" ref="action_report_payslip_ec"/>
        <field name="country_id" ref="base.ec"/>
        <field name="type_id" ref="l10n_ec_structure_type_employee"/>
        <field name="use_worked_day_lines" eval="False"/>
        <field name="unpaid_work_entry_type_ids" eval="[(4, ref('hr_work_entry.work_entry_type_unpaid_leave'))]"/>
        <field name="rule_ids" eval="[]"/>
    </record>
    <record id="l10n_ec_structure_type_employee" model="hr.payroll.structure.type">
        <field name="default_struct_id" ref="l10n_ec_structure_employee"/>
    </record>

    <record id="l10n_ec_structure_intern" model="hr.payroll.structure">
        <field name="name">Ecuador: Nómina mensual pasante</field>
        <field name="code">EC_PASANTE</field>
        <field name="report_id" ref="action_report_payslip_ec"/>
        <field name="country_id" ref="base.ec"/>
        <field name="type_id" ref="l10n_ec_structure_type_intern"/>
        <field name="use_worked_day_lines" eval="False"/>
        <field name="unpaid_work_entry_type_ids" eval="[(4, ref('hr_work_entry.work_entry_type_unpaid_leave'))]"/>
        <field name="rule_ids" eval="[]"/>
    </record>
    <record id="l10n_ec_structure_type_intern" model="hr.payroll.structure.type">
        <field name="default_struct_id" ref="l10n_ec_structure_intern"/>
    </record>
</odoo>
