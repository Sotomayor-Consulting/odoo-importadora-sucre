<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tipos de entrada de Ecuador: valores variables que se ingresan en el recibo
         (o que llegan desde ajustes salariales) y que las reglas leen con inputs['CODIGO'].
         Cada tipo solo aparece en las estructuras indicadas en struct_ids. -->

    <!-- ===== Dias ===== -->

    <record id="l10n_ec_input_dias_no_pagados" model="hr.payslip.input.type">
        <field name="name">Días no laborados (sin sueldo)</field>
        <field name="code">EC_DIAS_NO_PAGADOS</field>
        <field name="country_id" ref="base.ec"/>
        <field name="struct_ids" eval="[(4, ref('l10n_ec_structure_employee')), (4, ref('l10n_ec_structure_intern'))]"/>
        <!-- Se ingresa la cantidad de dias: permisos sin sueldo, faltas injustificadas. Se restan de los dias pagados. -->
        <field name="is_quantity" eval="True"/>
    </record>

    <!-- ===== Ingresos gravables (aportables al IESS) ===== -->

    <record id="l10n_ec_input_horas_suplementarias" model="hr.payslip.input.type">
        <field name="name">Horas suplementarias (50 %)</field>
        <field name="code">EC_HORAS_SUPL</field>
        <field name="country_id" ref="base.ec"/>
        <field name="struct_ids" eval="[(4, ref('l10n_ec_structure_employee'))]"/>
        <!-- Se ingresa la cantidad de horas; la regla calcula (sueldo / 240) x 1.5 x horas -->
        <field name="is_quantity" eval="True"/>
    </record>

    <record id="l10n_ec_input_horas_extraordinarias" model="hr.payslip.input.type">
        <field name="name">Horas extraordinarias (100 %)</field>
        <field name="code">EC_HORAS_EXTRA</field>
        <field name="country_id" ref="base.ec"/>
        <field name="struct_ids" eval="[(4, ref('l10n_ec_structure_employee'))]"/>
        <!-- Se ingresa la cantidad de horas; la regla calcula (sueldo / 240) x 2 x horas -->
        <field name="is_quantity" eval="True"/>
    </record>

    <record id="l10n_ec_input_comisiones" model="hr.payslip.input.type">
        <field name="name">Comisiones</field>
        <field name="code">EC_COMISION</field>
        <field name="country_id" ref="base.ec"/>
        <field name="struct_ids" eval="[(4, ref('l10n_ec_structure_employee')), (4, ref('l10n_ec_structure_intern'))]"/>
    </record>

    <record id="l10n_ec_input_bonos" model="hr.payslip.input.type">
        <field name="name">Bonos</field>
        <field name="code">EC_BONO</field>
        <field name="country_id" ref="base.ec"/>
        <field name="struct_ids" eval="[(4, ref('l10n_ec_structure_employee'))]"/>
        <!-- Un bono fijo mensual se puede registrar como ajuste salarial, sin fecha de fin -->
        <field name="available_in_attachments" eval="True"/>
        <field name="default_no_end_date" eval="True"/>
    </record>

    <!-- ===== Ingresos no gravables (no aportan al IESS) ===== -->

    <record id="l10n_ec_input_ingreso_no_aportable" model="hr.payslip.input.type">
        <field name="name">Otros ingresos no aportables</field>
        <field name="code">EC_ING_NO_APORT</field>
        <field name="country_id" ref="base.ec"/>
        <field name="struct_ids" eval="[(4, ref('l10n_ec_structure_employee'))]"/>
        <!-- Un ingreso no aportable recurrente (ej. movilizacion) se puede registrar como ajuste salarial -->
        <field name="available_in_attachments" eval="True"/>
        <field name="default_no_end_date" eval="True"/>
    </record>

    <!-- ===== Deducciones ===== -->

    <record id="l10n_ec_input_prestamo_quirografario" model="hr.payslip.input.type">
        <field name="name">Préstamo quirografario IESS</field>
        <field name="code">EC_PREST_QUIRO</field>
        <field name="country_id" ref="base.ec"/>
        <field name="struct_ids" eval="[(4, ref('l10n_ec_structure_employee'))]"/>
        <!-- La cuota viene de la planilla del IESS: se ingresa cada mes o como ajuste salarial -->
        <field name="available_in_attachments" eval="True"/>
    </record>

    <record id="l10n_ec_input_prestamo_hipotecario" model="hr.payslip.input.type">
        <field name="name">Préstamo hipotecario IESS</field>
        <field name="code">EC_PREST_HIPO</field>
        <field name="country_id" ref="base.ec"/>
        <field name="struct_ids" eval="[(4, ref('l10n_ec_structure_employee'))]"/>
        <field name="available_in_attachments" eval="True"/>
    </record>

    <record id="l10n_ec_input_descuento" model="hr.payslip.input.type">
        <field name="name">Descuentos a empleados</field>
        <field name="code">EC_DESCUENTO</field>
        <field name="country_id" ref="base.ec"/>
        <field name="struct_ids" eval="[(4, ref('l10n_ec_structure_employee'))]"/>
        <field name="available_in_attachments" eval="True"/>
    </record>

    <record id="l10n_ec_input_anticipo" model="hr.payslip.input.type">
        <field name="name">Anticipo de sueldo</field>
        <field name="code">EC_ANTICIPO</field>
        <field name="country_id" ref="base.ec"/>
        <field name="struct_ids" eval="[(4, ref('l10n_ec_structure_employee')), (4, ref('l10n_ec_structure_intern'))]"/>
        <!-- Anticipos extraordinarios. La quincena fija sale del campo del contrato. -->
    </record>
</odoo>
