<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tipos de estructura: se asignan al contrato (hr.version) y definen la estructura por defecto. -->
    <record id="l10n_ec_structure_type_employee" model="hr.payroll.structure.type">
        <field name="name">Ecuador: Empleado</field>
        <field name="country_id" ref="base.ec"/>
        <field name="wage_type">monthly</field>
        <field name="default_schedule_pay">monthly</field>
    </record>

    <record id="l10n_ec_structure_type_intern" model="hr.payroll.structure.type">
        <field name="name">Ecuador: Pasante</field>
        <field name="country_id" ref="base.ec"/>
        <field name="wage_type">monthly</field>
        <field name="default_schedule_pay">monthly</field>
    </record>
</odoo>
