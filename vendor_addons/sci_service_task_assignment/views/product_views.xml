<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_sci_service" model="ir.ui.view">
        <field name="name">product.template.form.sci.service.assignment</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Asignacion de servicio"
                      name="sci_service_assignment"
                      invisible="type != 'service'">
                    <group>
                        <group string="Responsable">
                            <field name="sci_task_user_id"/>
                            <field name="sci_task_role_id"/>
                        </group>
                        <group string="Estimacion">
                            <field name="sci_estimated_hours"/>
                            <field name="sci_deadline_days"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Vacio = se hereda de la categoria del producto. Aplica solo si el
                        producto crea tarea/proyecto al confirmar el pedido.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
