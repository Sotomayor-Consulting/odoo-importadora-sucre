<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="payment_provider_payphone" model="payment.provider">
            <field name="name">Payphone</field>
            <field name="code">payphone</field>
            <field name="state">disabled</field>
            <field name="is_published">0</field>
            <field name="redirect_form_view_id" ref="redirect_form"/>
            <field name="payment_method_ids"
                   eval="[Command.set([
                       ref('payment.payment_method_card'),
                   ])]"/>
            <field name="color">3</field>
            <field name="image_128"
                   type="base64"
                   file="payphone/static/description/icon.svg"/>
        </record>

    </data>
</odoo>
