<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_inherit_commission" model="ir.ui.view">
        <field name="name">hr.employee.form.commission</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group string="Comisiones" name="commissions" groups="hr.group_hr_user">
                    <field name="commission_base_salary"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
