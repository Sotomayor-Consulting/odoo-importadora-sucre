<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="commission_detail_line_view_list" model="ir.ui.view">
        <field name="name">commission.detail.line.list</field>
        <field name="model">commission.detail.line</field>
        <field name="arch" type="xml">
            <list string="Lineas de detalle de comision" decoration-muted="not is_calculated">
                <field name="is_calculated" column_invisible="1"/>
                <field name="date"/>
                <field name="order_date" optional="show"/>
                <field name="event_type" optional="show"/>
                <field name="sheet_id" optional="hide"/>
                <field name="employee_id"/>
                <field name="team_id" optional="show"/>
                <field name="rule_id" optional="show"/>
                <field name="rule_type" optional="hide"/>
                <field name="source" optional="hide"/>
                <field name="partner_id" optional="show"/>
                <field name="sale_order_id" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="quantity" optional="show"/>
                <field name="price_total" optional="hide"/>
                <field name="cost_amount" optional="hide"/>
                <field name="invoice_id" optional="hide"/>
                <field name="bank_statement_line_id" optional="hide"/>
                <field name="payment_transaction_id" optional="hide"/>
                <field name="stripe_fee" optional="hide"/>
                <field name="project_id" optional="hide"/>
                <field name="task_state" optional="hide"/>
                <field name="task_stage" optional="hide"/>
                <field name="task_user_names" optional="hide"/>
                <field name="base_amount" sum="Total"/>
                <field name="rate" optional="hide"/>
                <field name="fixed_amount" optional="hide"/>
                <field name="commission_amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="commission_detail_line_view_form" model="ir.ui.view">
        <field name="name">commission.detail.line.form</field>
        <field name="model">commission.detail.line</field>
        <field name="arch" type="xml">
            <form string="Linea de detalle" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Origen">
                            <field name="sheet_id"/>
                            <field name="line_id"/>
                            <field name="employee_id"/>
                            <field name="team_id"/>
                            <field name="source"/>
                            <field name="event_type"/>
                            <field name="rule_id"/>
                            <field name="rule_type"/>
                            <field name="is_calculated"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Fechas">
                            <field name="date"/>
                            <field name="order_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cliente y servicio">
                            <field name="partner_id"/>
                            <field name="sale_order_id"/>
                            <field name="sale_order_line_id"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="price_total"/>
                            <field name="cost_amount"/>
                            <field name="description"/>
                        </group>
                        <group string="Factura y cobro">
                            <field name="invoice_id"/>
                            <field name="bank_statement_line_id"/>
                            <field name="payment_transaction_id"/>
                            <field name="stripe_fee"/>
                        </group>
                    </group>
                    <group string="Proyecto y tarea">
                        <group>
                            <field name="project_id"/>
                            <field name="analytic_account_id"/>
                            <field name="project_last_update_status"/>
                        </group>
                        <group>
                            <field name="project_task_id"/>
                            <field name="task_state"/>
                            <field name="task_stage"/>
                            <field name="task_user_names"/>
                            <field name="task_date_last_stage_update"/>
                        </group>
                    </group>
                    <group string="Calculo">
                        <group>
                            <field name="base_amount"/>
                            <field name="rate"/>
                            <field name="fixed_amount"/>
                        </group>
                        <group>
                            <field name="commission_amount" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="commission_detail_line_view_pivot" model="ir.ui.view">
        <field name="name">commission.detail.line.pivot</field>
        <field name="model">commission.detail.line</field>
        <field name="arch" type="xml">
            <pivot string="Comisiones por origen">
                <field name="employee_id" type="row"/>
                <field name="product_id" type="col"/>
                <field name="commission_amount" type="measure"/>
                <field name="base_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="commission_detail_line_view_search" model="ir.ui.view">
        <field name="name">commission.detail.line.search</field>
        <field name="model">commission.detail.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="sheet_id"/>
                <field name="rule_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="invoice_id"/>
                <field name="payment_transaction_id"/>
                <field name="project_id"/>
                <filter string="Calculadas" name="calculated" domain="[('is_calculated','=',True)]"/>
                <filter string="Pendientes de calculo" name="pending" domain="[('is_calculated','=',False)]"/>
                <separator/>
                <filter string="Equipo CRM" name="src_team" domain="[('source','=','team')]"/>
                <filter string="Roles" name="src_role" domain="[('source','=','product_role')]"/>
                <filter string="Manuales" name="src_manual" domain="[('source','=','manual')]"/>
                <separator/>
                <filter string="Cobrado" name="e_bank" domain="[('event_type','=','bank_paid')]"/>
                <filter string="Factura pagada" name="e_invoice_paid" domain="[('event_type','=','invoice_paid')]"/>
                <filter string="Facturado" name="e_invoice" domain="[('event_type','=','invoice')]"/>
                <filter string="Vendido" name="e_order" domain="[('event_type','=','order')]"/>
                <separator/>
                <group>
                    <filter string="Empleado" name="group_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Producto" name="group_product" context="{'group_by':'product_id'}"/>
                    <filter string="Tipo evento" name="group_event_type" context="{'group_by':'event_type'}"/>
                    <filter string="Tipo regla" name="group_rule_type" context="{'group_by':'rule_type'}"/>
                    <filter string="Hoja" name="group_sheet" context="{'group_by':'sheet_id'}"/>
                    <filter string="Mes" name="group_month" context="{'group_by':'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commission_detail_line" model="ir.actions.act_window">
        <field name="name">Lineas de detalle</field>
        <field name="res_model">commission.detail.line</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="commission_detail_line_view_search"/>
    </record>

</odoo>
