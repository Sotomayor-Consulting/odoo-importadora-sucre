<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_team_view_form_inherit_commission" model="ir.ui.view">
        <field name="name">crm.team.form.commission</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Comisiones" name="commissions">
                        <group>
                            <field name="commission_active"/>
                        </group>
                        <group invisible="not commission_active">
                            <group string="Reparto y descuento">
                                <field name="commission_split_method"/>
                                <field name="commission_base_salary_deduction"/>
                            </group>
                            <group string="Tasa por defecto (catch-all)">
                                <field name="commission_computation" widget="radio"/>
                                <field name="commission_rate" invisible="commission_computation != 'percentage'"/>
                                <field name="commission_fixed_amount" invisible="commission_computation != 'fixed'"/>
                            </group>
                        </group>
                        <separator string="Reglas de comision" invisible="not commission_active"/>
                        <field name="commission_rate_rule_ids" invisible="not commission_active"
                               context="{'default_team_id': id}">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="frequency"/>
                                <field name="rule_type"/>
                                <field name="amount_basis" optional="show"/>
                                <field name="product_ids" widget="many2many_tags" optional="show"/>
                                <field name="product_category_ids" widget="many2many_tags" optional="show"/>
                                <field name="computation_type"/>
                                <field name="rate" optional="show"/>
                                <field name="fixed_amount" optional="show"/>
                                <field name="active" optional="hide"/>
                            </list>
                        </field>
                        <p class="text-muted" invisible="not commission_active">
                            Cada regla declara su <strong>frecuencia</strong> (mensual / trimestral / anual)
                            y su <strong>tipo</strong> (cobrado / facturado / vendido / margen / cantidad).
                            Precedencia de matching: regla por producto, regla por categoria, catch-all del equipo.
                        </p>
                    </page>
            </xpath>
        </field>
    </record>

</odoo>
