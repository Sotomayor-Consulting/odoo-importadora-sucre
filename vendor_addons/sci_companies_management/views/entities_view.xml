<odoo>
  <data>
    <!-- explicit list view definition -->

    <record id="view_entities_registration_list" model="ir.ui.view">
      <field name="name">sci_companies_management.entity.list</field>
      <field name="model">sci_companies_management.entity</field>
      <field name="arch" type="xml">
        <list default_order="name asc">
          
          <field name="name" />
          <field name="business_structure_id" />
          <field name="incorporation_state_id" />
          <field name="country_id" />
          <field name="identification_number" />
          <field name="partner_id" />
          <field name="email_irs" />
          <field name="incorporation_date" options="{'numeric':true}" />
          <field name="administration_method" />
          <field name="accounting_method" />
          <field name="status" width="100px" string="Estado" widget="badge"
            decoration-success="status in ['active']"
            decoration-danger="status in ['dissolved']" />
        </list>
      </field>
    </record>

    <record id="view_entities_registration_search" model="ir.ui.view">
      <field name="name">sci_companies_management.entity.search</field>
      <field name="model">sci_companies_management.entity</field>
      <field name="arch" type="xml">
        <search>
          <field name="name" />
          <field name="identification_number" />
          <field name="partner_id" />
          <field name="email_irs" />
          <filter string="Activo" name="filter_active"
            domain="[('status', '=', 'active')]" />
          <filter string="Inactivo" name="filter_inactive"
            domain="[('status', '=', 'inactive')]" />
          <filter string="Disuelto" name="filter_dissolved"
            domain="[('status', '=', 'dissolved')]" />
          <separator />
          <filter string="Por estructura" name="group_structure"
            context="{'group_by': 'business_structure_id'}" />
          <filter string="Por jurisdicción" name="group_country"
            context="{'group_by': 'country_id'}" />
          <filter string="Por estado" name="group_status"
            context="{'group_by': 'status'}" />
        </search>
      </field>
    </record>

    <record id="view_entities_registration_form" model="ir.ui.view">
      <field name="name">sci_companies_management.entity.form</field>
      <field name="model">sci_companies_management.entity</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_register" string="Validar y Registrar"
                    type="object" class="btn-primary"
                    confirm="¿Está seguro de registrar esta entidad? Se validarán todos los datos."
                    invisible="status != 'draft'"/>
            <button name="action_set_active" string="Activar"
                    type="object"
                    invisible="status != 'registered'"/>
            <button name="action_dissolve" string="Disolver"
                    type="object"
                    confirm="¿Está seguro de disolver esta entidad?"
                    invisible="status not in ('registered', 'active')"/>
            <field name="status" widget="statusbar"
              statusbar_visible="draft,registered,active,dissolved" clickable="0"/>
          </header>
          <sheet>
            <div class="oe_title">
              <field name="business_structure_id"
                placeholder="Estructura legal..." />
              <field name="name" class="fs-2"
                placeholder="Nombre de la empresa..." />
            </div>
            <group>
              <group>
                <field name="contact_id" widget="res_partner_many2one"
                  placeholder="Persona de contacto"
                  context="{'show_address':1}" />
                <field name="identification_number"
                  placeholder="12-3456789" />
                <field name="incorporation_state_id"
                  placeholder="Estado"
                  domain="[('country_id', '=', country_id)]" />
                <field name="administration_method"
                  placeholder="Seleccione..." />
                <field name="partner_id"
                  placeholder="Empresa vinculada" />
              </group>
              <group>
                <field name="country_id" placeholder="Jurisdiccion" />
                <field name="incorporation_date"
                  placeholder="dd/mm/yyyy"
                  options="{'numeric':true}" />
                <field name="joint_ownership" />
                <field name="billing_partner_id"
                  placeholder="Contacto facturación"
                  invisible="not partner_id or partner_id == billing_partner_id"
                  help="Solo se muestra si es diferente de la empresa vinculada"/>
              </group>
            </group>
            <notebook>
              <page string="Miembros">
                <field name="member_line_ids" nolabel="1"
                  context="{'default_entity_id': id}">
                  <list editable="bottom">
                    <field name="member_id" />
                    <field name="role_ids" widget="many2many_tags"
                      domain="[('structure_ids', 'in', parent.business_structure_id)]"/>
                    <field name="percentage" widget="percentage" sum="Total"
                      invisible="not role_ids"/>
                    <field name="date_start" widget="date" optional="show"/>
                    <field name="date_end" widget="date" optional="show"/>
                    <field name="participation_type" optional="show"/>
                    <field name="is_beneficial_owner" optional="show"/>
                    <field name="is_designated_by_us" optional="show"/>
                  </list>
                </field>
                <group>
                  <group>
                    <field name="members_privacy" />
                  </group>
                  <group>
                    <field name="manager_privacy" />
                  </group>
                </group>
              </page>
              <page string="Actividad">
                <group>
                  <group>
                    <field name="activity_id" />
                    <field name="service"
                      placeholder="Ej: Consultoría fiscal, Contabilidad" />
                    <field name="company_service" />
                  </group>
                  <group>
                    <field name="us_source_income" />
                    <field name="service_description"
                      placeholder="Describa las actividades principales de la entidad..." />
                  </group>
                </group>
              </page>
              <page string="Cumplimiento">
                <group>
                  <group>
                    <field name="taxation_type" widget="radio"
                      options="{'horizontal': true}" />
                    <field name="email_irs"
                      placeholder="correo@ejemplo.com" />
                  </group>
                  <group>
                    <field name="accounting_method" widget="radio"
                      options="{'horizontal': true}" />
                    <field name="signature" widget="signature" nolabel="1" />
                  </group>
                </group>
                <group string="FinCEN">
                  <field name="report_fincen_ids" nolabel="1">
                    <list>
                      <field name="name" />
                      <field name="status" />
                      <field name="filing_date" />
                      <field name="expiration_date" />
                    </list>
                  </field>
                </group>
              </page>
              <page string="Documentos">
                <field name="document_ids" nolabel="1"
                  context="{'default_entity_id': id, 'default_res_model': 'sci_companies_management.entity', 'default_res_id': id}">
                  <kanban class="o_kanban_attachment o_entity_documents_kanban">
                    <field name="id" />
                    <field name="mimetype" />
                    <field name="file_name" />
                    <field name="document_type_id" />
                    <field name="issue_date" />
                    <templates>
                      <t t-name="card" class="o_kanban_attachment flex-row">
                        <aside class="o_kanban_image m-1">
                          <div class="o_kanban_image_wrapper d-flex align-items-center justify-content-center">
                            <t t-set="webimage"
                              t-value="new RegExp('image.*(gif|jpeg|jpg|png|webp)').test(record.mimetype.value)" />
                            <a t-attf-href="/web/content?model=sci_companies_management.document&amp;id=#{record.id.raw_value}&amp;field=file&amp;filename_field=file_name&amp;download=false"
                              class="o_attachment_link o_entity_document_preview"
                              t-att-data-doc-id="record.id.raw_value"
                              t-att-data-filename="record.file_name.value"
                              t-att-data-mimetype="record.mimetype.value"
                              t-att-data-url="'/web/content?model=sci_companies_management.document&amp;id=' + record.id.raw_value + '&amp;field=file&amp;filename_field=file_name&amp;download=false'"
                              t-att-data-download-url="'/web/content?model=sci_companies_management.document&amp;id=' + record.id.raw_value + '&amp;field=file&amp;filename_field=file_name&amp;download=true'">
                              <img t-if="webimage"
                                t-attf-src="/web/image?model=sci_companies_management.document&amp;id=#{record.id.raw_value}&amp;field=file"
                                width="100" height="100" alt="Documento"
                                class="o_attachment_image" />
                              <span t-else="" class="o_image o_image_thumbnail"
                                t-att-title="record.file_name.value"
                                t-att-data-mimetype="record.mimetype.value" role="img" />
                            </a>
                          </div>
                        </aside>
                        <main class="ms-1">
                          <div class="o_kanban_details_wrapper d-flex flex-column">
                            <div class="text-truncate fw-bold fs-5">
                              <field name="file_name" />
                            </div>
                            <div class="text-muted">
                              <field name="document_type_id"
                                domain="[('target_model', '=', 'entity')]" />
                            </div>
                            <div class="d-flex">
                              <field name="issue_date" />
                            </div>
                          </div>
                        </main>
                      </t>
                    </templates>
                  </kanban>
                  <form string="Documento">
                    <group>
                      <group>
                        <field name="document_type_id"
                          domain="[('target_model', '=', 'entity')]" />
                        <field name="file_name" />
                        <field name="issue_date" />
                        <field name="mimetype" readonly="1" />
                      </group>
                      <group>
                        <field name="file" filename="file_name" />
                        <field name="preview_html" widget="html" readonly="1" />
                      </group>
                    </group>
                  </form>
                </field>
              </page>
              <page string="Direcciones">
                <field name="address_ids" nolabel="1">
                  <kanban>
                    <field name="address_type" />
                    <field name="country_id" />
                    <field name="street" />
                    <field name="street2" />
                    <field name="zip" />
                    <field name="city" />
                    <field name="state_id" />
                    <templates>
                      <t t-name="card" class="p-2 mb-5 rounded">
                        <div class="oe_kanban_details d-flex flex-column h-100">
                          <div class="o_kanban_record_top mb-2">
                            <strong class="o_kanban_record_title">
                              <field name="address_type" widget="badge" />
                            </strong>
                          </div>
                          <div class="o_kanban_record_body flex-grow-1 text-muted">
                            <div t-if="record.street.raw_value">
                              <field name="street" />
                            </div>
                            <div t-if="record.street2.raw_value">
                              <field name="street2" />
                            </div>
                            <div
                              t-if="record.city.raw_value or record.state_id.raw_value or record.zip.raw_value">
                              <span t-if="record.city.raw_value">
                                <field name="city" />
                              </span>
                              <span t-if="record.state_id.raw_value">, <field name="state_id" /></span>
                              <span t-if="record.zip.raw_value">
                                <field name="zip" />
                              </span>
                            </div>
                          </div>
                          <div class="o_kanban_record_bottom mt-auto pt-2">
                            <div class="oe_kanban_bottom_left fw-bold">
                              <i class="fa fa-map-marker text-primary me-1"
                                t-if="record.country_id.raw_value" />
                              <field name="country_id" />
                            </div>
                          </div>
                        </div>
                      </t>
                    </templates>
                  </kanban>
                </field>
              </page>
              <page string="Agente Residente">
                <field name="resident_agent_history_ids" nolabel="1">
                  <list>
                    <field name="agent_id" />
                    <field name="is_active" />
                    <field name="start_date" />
                    <field name="end_date" />
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
          <chatter />
        </form>
      </field>
    </record>
  </data>
</odoo>
