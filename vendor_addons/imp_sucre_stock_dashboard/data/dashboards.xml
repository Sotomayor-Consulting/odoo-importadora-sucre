<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dashboard_existencias" model="spreadsheet.dashboard">
        <field name="name">Existencias</field>
        <field name="spreadsheet_binary_data" type="base64"
               file="imp_sucre_stock_dashboard/data/files/existencias_dashboard.json"/>
        <field name="main_data_model_ids" eval="[(4, ref('stock.model_stock_quant'))]"/>
        <field name="dashboard_group_id"
               ref="spreadsheet_dashboard.spreadsheet_dashboard_group_logistics"/>
        <field name="group_ids" eval="[Command.link(ref('stock.group_stock_manager'))]"/>
        <field name="sequence">10</field>
        <field name="is_published">True</field>
    </record>

</odoo>
