<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu Accion de la lista de recibos: paga los recibos seleccionados con el asistente estandar. -->
    <record id="action_hr_payslip_register_payment" model="ir.actions.server">
        <field name="name">Registrar pago</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_register_payment()</field>
    </record>
</odoo>
