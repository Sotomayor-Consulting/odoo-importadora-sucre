<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_run_view_kanban" model="ir.ui.view">
        <field name="name">hr.payslip.run.kanban.inherit.l10n.ec.hr.payroll.account</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_view_kanban"/>
        <field name="arch" type="xml">
            <field name="color" position="after">
                <field name="country_code"/>
            </field>
            <button name="action_paid" position="before">
                <button name="action_register_payment" type="object" class="btn btn-primary" string="Registrar pago"
                        invisible="state != '02_close' or country_code != 'EC'"
                        groups="account.group_account_invoice" options="{'is_priority': True}"/>
            </button>
        </field>
    </record>
</odoo>
