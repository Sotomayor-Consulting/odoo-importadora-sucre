<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ec_hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.form.l10n.ec.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <group name="payroll_group" position="inside">
                <group string="Nomina Ecuador" invisible="company_country_code != 'EC'">
                    <field name="l10n_ec_service_time_display" readonly="1"/>
                    <field name="l10n_ec_service_days" readonly="1"/>
                    <field name="l10n_ec_iess_affiliated"/>
                    <field name="l10n_ec_apply_iess"/>
                    <field name="l10n_ec_thirteenth_salary_payment"/>
                    <field name="l10n_ec_fourteenth_salary_payment"/>
                    <field name="l10n_ec_reserve_fund_payment"/>
                    <separator string="Quincena"/>
                    <field name="l10n_ec_pay_quincena"/>
                    <field name="l10n_ec_quincena_amount" invisible="not l10n_ec_pay_quincena"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
