<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_template_view_form" model="ir.ui.view">
        <field name="name">hr.contract.template.view.form.inherit.l10n.ec.hr.payroll</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr_payroll.hr_contract_template_view_form"/>
        <field name="arch" type="xml">
            <group name="salary_info" position="inside">
                <group string="Nomina Ecuador" invisible="country_code != 'EC'">
                    <field name="l10n_ec_iess_affiliated"/>
                    <field name="l10n_ec_apply_iess"/>
                    <field name="l10n_ec_thirteenth_salary_payment"/>
                    <field name="l10n_ec_fourteenth_salary_payment"/>
                    <field name="l10n_ec_reserve_fund_payment"/>
                    <separator string="Quincena"/>
                    <field name="l10n_ec_pay_quincena"/>
                    <field name="l10n_ec_quincena_amount" invisible="not l10n_ec_pay_quincena"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
