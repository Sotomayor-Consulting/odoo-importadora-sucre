<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ec_salary_rule_basic" model="hr.salary.rule">
        <field name="name">Sueldo basico</field>
        <field name="code">BASIC</field>
        <field name="sequence">100</field>
        <field name="struct_id" ref="l10n_ec_payroll_structure_employee"/>
        <field name="category_id" ref="l10n_ec_salary_rule_category_earnings"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._l10n_ec_get_base_wage(version)</field>
        <field name="appears_on_payslip">True</field>
    </record>

    <record id="l10n_ec_salary_rule_iess_employee" model="hr.salary.rule">
        <field name="name">Aporte IESS trabajador</field>
        <field name="code">IESS_EMPLOYEE</field>
        <field name="sequence">200</field>
        <field name="struct_id" ref="l10n_ec_payroll_structure_employee"/>
        <field name="category_id" ref="l10n_ec_salary_rule_category_deductions"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">base_wage = payslip._l10n_ec_get_base_wage(version)
result = version and version.l10n_ec_apply_iess and base_wage * payslip._rule_parameter('EC_IESS_EMPLOYEE_RATE') / 100.0 or 0.0</field>
        <field name="appears_on_payslip">True</field>
    </record>

