        <field name="category_id" ref="l10n_ec_salary_rule_category_net"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = categories['EC_EARN'] - categories['EC_DED']</field>
