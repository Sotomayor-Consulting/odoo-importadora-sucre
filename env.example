# Copiar estos valores al panel de variables de entorno de Dokploy.
# Este archivo es solo una plantilla: NO poner aqui valores reales.

# Credenciales de PostgreSQL.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=cambiar_por_una_clave_larga

# URL prefirmada del tarball de Odoo en Cloudflare R2.
# Se genera con:
#   aws s3 presign s3://TU_BUCKET/odoo_19.0+e.20260902.tar.gz \
#     --endpoint-url https://TU_ACCOUNT_ID.r2.cloudflarestorage.com \
#     --expires-in 604800
# Caduca (maximo 7 dias). Ver docs/despliegue-dokploy.md, seccion "Caducidad".
R2_URL=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com/...firma...
