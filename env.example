# Copiar estos valores al panel de variables de entorno de Dokploy.
# Este archivo es solo una plantilla: NO poner aqui valores reales.
#
# El repositorio y la imagen son IDENTICOS en staging y produccion. Lo unico
# que distingue un entorno de otro son estas variables. Donde el valor cambia,
# se indican los dos.

# =========================================================================
# Identidad del entorno
# =========================================================================

# Nombre corto y unico del entorno en el servidor: 'staging' o 'prod'.
# Forma parte del nombre del router de Traefik del websocket; dos stacks con
# el mismo ENV_NAME en el mismo servidor se pisan.
ENV_NAME=staging

# Dominio publico. Debe ser el MISMO que configuras como dominio del servicio
# en la UI de Dokploy (lo usa el router del websocket en docker-compose.yml).
#   produccion: erp.tudominio.com     staging: staging.tudominio.com
DOMAIN=staging.tudominio.com

# =========================================================================
# Base de datos
# =========================================================================

# PostgreSQL es un servicio aparte en Dokploy, no parte de este stack.
# Ver docs/postgres-dokploy.md para crearlo.
#
# DB_HOST es el "host interno" que Dokploy muestra en el servicio Postgres de
# ESTE entorno. OBLIGATORIA. (En local, con docker-compose.local.yml: db)
DB_HOST=nombre-interno-del-servicio-postgres
DB_PORT=5432

# Nombre de la base. OBLIGATORIA y sin valor por defecto: si falta, el
# despliegue falla en vez de apuntar a la base de otro entorno.
#   produccion: importadora_sucre     staging: importadora_staging
DB_NAME=importadora_staging

# Rol de aplicacion de Odoo (SIN superusuario; solo LOGIN y CREATEDB). Se crea
# a mano una vez en el servicio Postgres (docs/postgres-dokploy.md, seccion 3).
# NO es el usuario administrador del servicio: ese no se configura aqui.
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=cambiar_por_una_clave_larga

# =========================================================================
# Odoo
# =========================================================================

# Master password de Odoo (gestion de bases). Distinta en cada entorno.
ADMIN_PASSWD=cambiar_por_una_tercera_clave_larga

# Dimensionamiento. Si se omiten, docker-compose.yml aplica los valores de
# staging (los mas conservadores). Referencia para un VPS de 4 vCPU / 8 GB
# compartido por los dos entornos, con ~5 usuarios (2-3 a la vez):
#
#                              staging        produccion
#   ODOO_WORKERS               2              3
#   ODOO_MAX_CRON_THREADS      1              1
#   ODOO_LIMIT_MEMORY_SOFT     1073741824     1610612736   (1 GB / 1,5 GB)
#   ODOO_LIMIT_MEMORY_HARD     1610612736     2147483648   (1,5 GB / 2 GB)
#   ODOO_MEM_LIMIT             2g             4g
#   ODOO_CPUS                  1.5            3
#
# Regla de Odoo: 1 worker atiende ~6 usuarios simultaneos. No bajar de 2: con
# workers=0 no se abre el puerto 8072 y el websocket deja de funcionar.
ODOO_WORKERS=2
ODOO_MAX_CRON_THREADS=1
ODOO_LIMIT_MEMORY_SOFT=1073741824
ODOO_LIMIT_MEMORY_HARD=1610612736
# Techo de memoria y CPU del contenedor (lo aplica Docker, no Odoo). Protege a
# un entorno del otro cuando comparten servidor.
ODOO_MEM_LIMIT=2g
ODOO_CPUS=1.5

# Tiempos maximos por peticion, en segundos. Iguales en los dos entornos.
ODOO_LIMIT_TIME_CPU=600
ODOO_LIMIT_TIME_REAL=1200
ODOO_LIMIT_TIME_REAL_CRON=1800

# Conexiones a Postgres por proceso de Odoo. (workers + 2) x este valor debe
# quedar por debajo del max_connections del servicio Postgres
# (docs/postgres-dokploy.md, seccion 4).
ODOO_DB_MAXCONN=20

# Cualquier otra opcion de odoo.conf se puede fijar igual, sin tocar el repo:
# Odoo 19 lee ODOO_<OPCION> del entorno. Habria que añadirla tambien al bloque
# 'environment' de docker-compose.yml para que llegue al contenedor.

# =========================================================================
# Operacion
# =========================================================================

# No inicializar la base al arrancar.
#   produccion: vacio (el entrypoint la crea la primera vez)
#   staging:    1     (la base se restaura con scripts/refresh-staging.sh)
SKIP_DB_INIT=1

# Actualizacion de modulos en el arranque. Vacio en operacion normal.
# Se pone SOLO en el despliegue de actualizacion y se vuelve a vaciar:
#   UPGRADE=all           -> actualiza todos los modulos (aplica migraciones)
#   UPGRADE=mi_modulo     -> actualiza solo ese modulo
UPGRADE=

# =========================================================================
# Build
# =========================================================================

# Descarga del fuente de Odoo desde un bucket privado de Cloudflare R2.
# Iguales en staging y produccion.
#
# Token de R2 de SOLO LECTURA, limitado a ese bucket y sin fecha de caducidad.
# Se crea en Cloudflare: R2 > Manage API Tokens > Create API Token
#   Permissions: Object Read only      Specify bucket: el del tarball
#   TTL: Forever
# Cloudflare muestra el secreto UNA sola vez.
# OJO: los NOMBRES van en MAYUSCULAS; docker-compose.yml los referencia en el
# bloque 'secrets'.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# URL completa del objeto: endpoint S3 de la cuenta + bucket + nombre.
# El nombre del objeto NO debe llevar '+' ni espacios: en la URL habria que
# codificarlos y la firma de la peticion puede no coincidir. Subir el tarball
# con un nombre plano, p. ej. odoo-19.0-e-20260902.tar.gz
R2_OBJECT_URL=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com/TU_BUCKET/odoo-19.0-e-20260902.tar.gz
