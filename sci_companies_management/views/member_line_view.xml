<odoo>
    <data>
        <record id="view_entity_member_line_list" model="ir.ui.view">
            <field name="name">sci_companies_management.member.line.list</field>
            <field name="model">sci_companies_management.member.line</field>
            <field name="arch" type="xml">
                <list>
                    <field name="member_id"/>
                    <field name="role_ids" widget="many2many_tags"/>
                    <field name="percentage" widget="percentage" sum="Total"/>
                    <field name="date_start" widget="date"/>
                    <field name="date_end" widget="date"/>
                </list>
            </field>
        </record>
        <record id="view_entity_member_line_form" model="ir.ui.view">
                <field name="name">sci_companies_management.member.line.form</field>
                <field name="model">sci_companies_management.member.line</field>
                <field name="arch" type="xml">
                    <form>
                        <sheet>
                            <group>
                                <field name="entity_id" string="Empresa" readonly="1"/>
                                <field name="member_id" string="Miembro"/>
                                <field name="role_ids" widget="many2many_tags"/>
                                <field name="percentage" widget="percentage"/>
                                <field name="date_start" widget="date"/>
                                <field name="date_end" widget="date"/>
                                <field name="participation_type"/>
                                <field name="is_beneficial_owner"/>
                                <field name="is_designated_by_us"/>
                            </group>
                        </sheet>
                    </form>
                </field>
        </record>
    </data>
</odoo>