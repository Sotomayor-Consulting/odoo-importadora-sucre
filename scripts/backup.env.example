# Configuracion de backup.sh
# Copiar a scripts/backup.env (esta en .gitignore) y rellenar.
# Ver los contenedores con:  docker ps --format '{{.Names}}'

# --- Contenedores de produccion ---
DB_CONTAINER=importadora-prod-db-1
ODOO_CONTAINER=importadora-prod-odoo-1

# --- Base y credenciales (el rol de aplicacion basta para pg_dump) ---
DB=importadora_sucre
DB_USER=odoo
DB_PASSWORD=

# --- Destino local (host). Un directorio persistente del VPS. ---
BACKUP_DIR=/opt/importadora/backups
# Dias de copias locales a conservar. Las de R2 se purgan con lifecycle.
RETENTION_DAYS=7

# --- Offsite en Cloudflare R2 (recomendado). Dejar vacio para solo-local. ---
# Requiere el CLI 'aws' instalado en el host.
R2_BUCKET=importadora-backups
R2_PREFIX=odoo-backups
R2_ENDPOINT=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com
# Credenciales de un token de R2 con permiso de escritura SOLO en ese bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
