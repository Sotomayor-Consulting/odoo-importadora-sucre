# Configuracion de refresh-staging.sh
# Copiar a scripts/refresh-staging.env (esta en .gitignore) y rellenar.
# Este archivo NO lleva credenciales reales.
#
# Los nombres de contenedor se ven con:  docker ps --format '{{.Names}}'
# En Dokploy suelen tener un sufijo aleatorio; copia el nombre exacto.

# --- Contenedores (host donde corren ambos stacks) ---
PROD_DB_CONTAINER=importadora-prod-db-1
PROD_ODOO_CONTAINER=importadora-prod-odoo-1
STAGING_DB_CONTAINER=importadora-staging-db-1
STAGING_ODOO_CONTAINER=importadora-staging-odoo-1

# --- Bases de datos ---
PROD_DB=importadora_sucre
STAGING_DB=importadora_staging

# --- Credenciales PostgreSQL ---
# Rol de aplicacion en PRODUCCION (para el pg_dump; solo lectura).
PROD_DB_USER=odoo
PROD_DB_PASSWORD=

# Superusuario del cluster de STAGING (crea/borra la base de staging).
STAGING_ADMIN_USER=odoo_admin
STAGING_ADMIN_PASSWORD=

# Rol de aplicacion en STAGING (dueño de la base; se restaura con el).
APP_DB_USER=odoo
APP_DB_PASSWORD=

# --- URL publica de staging (se fija en web.base.url y se congela) ---
STAGING_BASE_URL=https://staging.tudominio.com

# --- Opcional: extensiones que exigen superusuario, si tu prod las usa ---
# Espacio-separadas. Vacio si tu produccion corre como rol no-superusuario
# (entonces no tiene extensiones que requieran superuser). Ej: "unaccent pg_trgm"
STAGING_EXTENSIONS=
