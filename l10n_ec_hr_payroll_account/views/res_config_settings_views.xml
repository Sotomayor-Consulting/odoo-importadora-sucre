<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_l10n_ec_hr_payroll_account" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n.ec.hr.payroll.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Nomina" name="l10n_ec_hr_payroll_account" groups="account.group_account_manager">
                    <block title="Contabilidad nomina Ecuador">
                        <setting string="Cuentas decimo tercero">
                            <div class="content-group">
                                <field name="l10n_ec_thirteenth_salary_expense_account_id"/>
                                <field name="l10n_ec_thirteenth_salary_provision_account_id"/>
                            </div>
                        </setting>
                        <setting string="Cuentas decimo cuarto">
                            <div class="content-group">
                                <field name="l10n_ec_fourteenth_salary_expense_account_id"/>
                                <field name="l10n_ec_fourteenth_salary_provision_account_id"/>
                            </div>
                        </setting>
                        <setting string="Cuentas fondos de reserva">
                            <div class="content-group">
                                <field name="l10n_ec_reserve_fund_expense_account_id"/>
                                <field name="l10n_ec_reserve_fund_provision_account_id"/>
                            </div>
                        </setting>
                        <setting string="Cuentas IESS patronal">
                            <div class="content-group">
                                <field name="l10n_ec_iess_employer_expense_account_id"/>
                                <field name="l10n_ec_iess_employer_liability_account_id"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
