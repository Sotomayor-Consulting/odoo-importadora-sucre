<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_stripe_fee" model="ir.ui.view">
        <field name="name">payment.provider.stripe.fee</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="after">
                <group string="Stripe Fee Configuration" invisible="code != 'stripe'">
                    <field name="stripe_fee_percentage"/>
                    <field name="stripe_fee_product_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
